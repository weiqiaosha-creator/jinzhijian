# ==================== 瑾之笺 .gitignore ====================

# OS 系统文件
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
.metadata/

# 本地开发辅助脚本
copy-libs.bat
copy-libs.vbs

# 本地图标目录（不入库，避免 JPG 格式兼容问题）
icons/

# 根目录的临时副本（稳定版已在 stable/ 下）
# 如果稳定版已就绪，可以忽略根目录的 JS 源副本
# （默认保留根目录文件以便本地参考发布前审核）

# 压缩包
*.zip
*.tar.gz
*.rar

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 依赖（未来如果加 npm scripts）
node_modules/